@using Legal.Localization
@using Legal.Resources
@inject IStringLocalizer<AvisoLegalResource> L
@inject IJSRuntime JS

@* Once idiomas ya no caben en una fila de botones: se elige aquí, con bandera y agrupado por
   continentes. En Europa y Asia cada idioma sale una vez; en América y Oceanía sale cada país con
   el idioma que habla, con el nombre del país debajo para distinguirlos. *@
<button type="button" class="button is-small language-trigger" @onclick="OpenPicker">
    <img src="@Current.FlagVectorUrl" width="22" height="15" alt="@Current.NativeName" />
    <span class="language-trigger-name">@Current.NativeName</span>
    <span class="language-trigger-caret">▾</span>
</button>

@if (IsOpen)
{
    <div class="language-backdrop" @onclick="ClosePicker"></div>
    <div class="language-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation>
        <header class="language-dialog-header">
            <span class="language-dialog-title">@L["LanguagePickerTitle"]</span>
            <button type="button" class="delete" aria-label="close" @onclick="ClosePicker"></button>
        </header>
        <div class="language-dialog-body">
            @foreach (LanguageContinent continent in SupportedLanguages.Continents)
            {
                <section class="language-group">
                    <h4 class="language-group-title">@L[GetContinentKey(continent)]</h4>
                    <div class="language-grid">
                        @foreach (SupportedLanguage language in SupportedLanguages.ByContinent(continent))
                        {
                            <button type="button"
                                    class="language-item @(language == Current ? "is-active" : "")"
                                    @onclick="() => SelectAsync(language)">
                                <img src="@language.FlagVectorUrl" width="22" height="15" alt="@language.NativeName" />
                                <span class="language-name">
                                    @language.NativeName
                                    @if (language.HasCountryName)
                                    {
                                        <small class="language-country">@language.CountryName</small>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
}

@code {
    private SupportedLanguage Current = SupportedLanguages.Default;
    private bool IsOpen;

    protected override void OnInitialized() =>
        Current = SupportedLanguages.Find(CultureInfo.CurrentUICulture.Name);

    // La bandera elegida con el idioma (español con la de México...) se guarda aparte de la cultura
    // y sólo se puede leer una vez pintada la página.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string countryCode = await ReadFlagAsync();
            SupportedLanguage remembered = SupportedLanguages.Find(Current.Code, countryCode);
            if (remembered != Current)
            {
                Current = remembered;
                StateHasChanged();
            }
        }
    }

    private async Task<string> ReadFlagAsync()
    {
        string result = null;

        try
        {
            result = await JS.InvokeAsync<string>("getLegalFlag");
        }
        catch (JSException)
        {
            result = null;
        }

        return result;
    }

    private void OpenPicker() => IsOpen = true;

    private void ClosePicker() => IsOpen = false;

    private static string GetContinentKey(LanguageContinent continent) => continent switch
    {
        LanguageContinent.Europe => "ContinentEurope",
        LanguageContinent.Asia => "ContinentAsia",
        LanguageContinent.Africa => "ContinentAfrica",
        LanguageContinent.America => "ContinentAmerica",
        _ => "ContinentOceania"
    };

    private async Task SelectAsync(SupportedLanguage language)
    {
        IsOpen = false;
        await JS.InvokeVoidAsync("setLegalFlag", language.CountryCode);

        if (language.Code != Current.Code)
        {
            // Guarda y recarga: Program.cs aplica la cultura antes de pintar.
            await JS.InvokeVoidAsync("setLegalCulture", language.Code);
        }
        else
        {
            Current = language;
        }
    }
}
